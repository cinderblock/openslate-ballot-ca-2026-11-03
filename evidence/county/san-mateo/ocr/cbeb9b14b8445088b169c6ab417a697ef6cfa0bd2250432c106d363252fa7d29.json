},{"text":"BALLOT MISINFORMATION!","x":285,"y":1682,"w":590,"h":42},{"text":"The current ballot language hoodwinks voters again!","x":282,"y":1813,"w":1043,"h":52},{"text":"Voters must read the fine print to discover the REAL plans:","x":280,"y":1942,"w":1143,"h":53},{"text":"-Yet another health and wellness club at Skyline","x":279,"y":2073,"w":939,"h":53},{"text":"-Two very costly Fine Arts Centers at Canada & Skyline","x":278,"y":2205,"w":1085,"h":54},{"text":"-Likely demolition of CSM's Library and Gym (two of the campus's remaining historic core","x":278,"y":2336,"w":1744,"h":59},{"text":"buildings)","x":279,"y":2398,"w":187,"h":53},{"text":"Are these the \"science, engineering, math, technology, skilled trades, and career-training","x":277,"y":2530,"w":1729,"h":58},{"text":"classrooms that prepare students for in-demand careers\" promised on the ballot?","x":278,"y":2591,"w":1584,"h":57},{"text":"II","x":2248,"y":514,"w":42,"h":75},{"text":"9","x":2199,"y":1673,"w":54,"h":115},{"text":"(O","x":2193,"y":2163,"w":74,"h":57}]},{"page":8,"width":2448,"height":3168,"lines":[{"text":"THEY HAVE ENOUGH MONEY!","x":302,"y":337,"w":640,"h":46},{"text":"Why costly new construction when enrollment is not increasing and online learning is","x":302,"y":469,"w":1649,"h":57},{"text":"growing?","x":302,"y":530,"w":179,"h":53},{"text":"Move over, military-industrial complex.","x":304,"y":661,"w":743,"h":53},{"text":"The construction unions-consultants complex has infiltrated school districts statewide,","x":302,"y":792,"w":1664,"h":55},{"text":"These special interests profit from demolition and costly new construction rather than repair","x":302,"y":922,"w":1779,"h":59},{"text":"and modernization of existing facilities.","x":302,"y":985,"w":753,"h":56},{"text":"MAKE NO MISTAKE: THIS IS A TAX INCREASE!","x":302,"y":1115,"w":985,"h":49},{"text":"The District claims your tax rate won't increase. That's misleading.","x":301,"y":1246,"w":1285,"h":62},{"text":"A new bond means new debt and decades of additional taxes.","x":300,"y":1378,"w":1266,"h":51},{"text":"Think of your mortgage or car loan. If you added 30 years of payments but kept the monthly","x":302,"y":1509,"w":1781,"h":60},{"text":"payment the same, would you say it cost you nothing?","x":302,"y":1572,"w":1055,"h":57},{"text":"Of course not.","x":302,"y":1702,"w":276,"h":43},{"text":"More years of taxes means more taxes paid. Period.","x":303,"y":1833,"w":1078,"h":54},{"text":"Vote NO on Measure !","x":300,"y":1963,"w":505,"h":43},{"text":"(Ö","x":2227,"y":769,"w":75,"h":58},{"text":"e)","x":2232,"y":1073,"w":40,"h":34},{"text":"C)","x":2216,"y":1108,"w":34,"h":37}]}]}
