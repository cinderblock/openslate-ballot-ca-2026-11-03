:","x":1101,"y":2459,"w":84,"h":31},{"text":"Email","x":1103,"y":2559,"w":95,"h":30},{"text":"QylDjJ CR $7107()","x":1111,"y":2672,"w":454,"h":70},{"text":"Date:","x":1102,"y":2760,"w":90,"h":31},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":320,"y":2877,"w":1864,"h":47}]},{"page":4,"width":2448,"height":3168,"lines":[{"text":"San Carlos School District","x":919,"y":280,"w":581,"h":40},{"text":"2026 Parcel Tax Measure — on the November 3, 2026 Ballot","x":545,"y":350,"w":1355,"h":48},{"text":"Argument In Favor of Measure","x":850,"y":418,"w":704,"h":50},{"text":"VOTE YES on Measure _ to protect our teachers and protect our property values. Seniors 65+","x":290,"y":543,"w":1829,"h":44},{"text":"can apply for an exemption.","x":291,"y":601,"w":550,"h":44},{"text":"San Carlos is a destination community with high-performing public schools. Demand for strong","x":290,"y":719,"w":1831,"h":45},{"text":"schools is what keeps our property values strong. In 2020, our community generously approved","x":290,"y":778,"w":1845,"h":45},{"text":"a parcel tax to fund teacher positions. When it expires, $3 million will disappear from our","x":291,"y":834,"w":1721,"h":47},{"text":"district's budget, forcing teacher layoffs and threatening cuts to programs in reading, writing,","x":291,"y":895,"w":1794,"h":44},{"text":"math, technology, arts, and more.","x":291,"y":953,"w":653,"h":43},{"text":"Measure is NOT a brand-new tax It simply renews our existing school funding with a modest","x":291,"y":1070,"w":1840,"h":44},{"text":"increase that preserves San Carlos School District's ability to fund and retain 24 teaching","x":291,"y":1128,"w":1704,"h":45},{"text":"positions.","x":291,"y":1189,"w":184,"h":42},{"text":"VOTING YES means:","x":290,"y":1306,"w":391,"h":34},{"text":"• Retaining our excellent teachers who make San Carlos schools great","x":364,"y":1363,"w":1378,"h":44},{"text":"e Maintaining lower class sizes for all learners","x":364,"y":1422,"w":917,"h":43},{"text":"e Preserving high-quality educational programs for San Carlos students in reading, math,","x":364,"y":1481,"w":1743,"h":45},{"text":"science, the arts, and more","x":433,"y":1539,"w":525,"h":42},{"text":"Safeguards for Seniors and Taxpayers are built in","x":289,"y":1656,"w":959,"h":44},{"text":"Senior homeowners 65+ are eligible for an exemption.","x":433,"y":1714,"w":1048,"h":44},{"text":"o BYLAW these funds cannot be taken by the State; every dollar stays in San Carlos.","x":364,"y":1773,"w":1645,"h":45},{"text":"No funds are allowed for administrators' salaries.","x":435,"y":1831,"w":946,"h":36},{"text":"Renters do not pay this tax.","x":435,"y":1890,"w":523,"h":43},{"text":"Join San Carlos parents, teachers, neighbors, and local business and community leaders in","x":287,"y":2007,"w":1734,"h":45},{"text":"voting Yes on Measure _. Whether or not you have school-age children, supporting quality","x":288,"y":2066,"w":1746,"h":45},{"text":"education is a wise investment that protects the well-being of our community and protects your","x":290,"y":2125,"w":1857,"h":45},{"text":"property values.","x":291,"y":2184,"w":310,"h":43},{"text":"VOTE YES on _. www.yesforscsd.org","x":288,"y":2301,"w":717,"h":44},{"text":"5","x":2268,"y":609,"w":37,"h":43},{"text":"3","x":2271,"y":1313,"w":35,"h":41},{"text":"9","x":2271,"y":1712,"w":32,"h":42}]}]}
