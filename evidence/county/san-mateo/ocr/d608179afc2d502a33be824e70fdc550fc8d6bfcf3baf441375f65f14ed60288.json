":"Date:","x":1115,"y":1159,"w":92,"h":32},{"text":"Title:","x":1113,"y":1264,"w":85,"h":31},{"text":"Email:","x":1116,"y":1363,"w":106,"h":32},{"text":"Date:","x":1116,"y":1564,"w":92,"h":31},{"text":"Title:","x":1114,"y":1668,"w":85,"h":32},{"text":"Email:","x":1117,"y":1767,"w":108,"h":32},{"text":"Date:","x":1117,"y":1968,"w":92,"h":31},{"text":"Title:","x":1115,"y":2071,"w":85,"h":32},{"text":"Email:","x":1118,"y":2172,"w":107,"h":32},{"text":"Date:","x":1118,"y":2373,"w":93,"h":32},{"text":"•tie:","x":1144,"y":2477,"w":58,"h":31},{"text":"Pronouns:","x":1919,"y":1058,"w":179,"h":31},{"text":"He/His:","x":1920,"y":1116,"w":126,"h":32},{"text":"She/Her:","x":1919,"y":1162,"w":154,"h":32},{"text":"Theyrrhem:","x":1917,"y":1208,"w":213,"h":40},{"text":"Pronouns:","x":1920,"y":1463,"w":179,"h":31},{"text":"He/His:","x":1920,"y":1521,"w":127,"h":31},{"text":"She/Her:","x":1919,"y":1566,"w":155,"h":32},{"text":"Theyffhem:","x":1918,"y":1612,"w":213,"h":39},{"text":"Pronouns:","x":1921,"y":1867,"w":180,"h":31},{"text":"He/His:","x":1922,"y":1924,"w":126,"h":32},{"text":"She/Her:","x":1920,"y":1970,"w":155,"h":32},{"text":"They/Them:","x":1919,"y":2016,"w":213,"h":39},{"text":"Pronouns:","x":1922,"y":2272,"w":180,"h":31},{"text":"Hen-lis:","x":1923,"y":2330,"w":126,"h":31},{"text":"Sh Her:","x":1923,"y":2376,"w":154,"h":31},{"text":"Pronouns:","x":1923,"y":2678,"w":180,"h":32},{"text":"He/His:","x":1924,"y":2735,"w":126,"h":32},{"text":"She/Her:","x":1923,"y":2782,"w":154,"h":32},{"text":"The IThem:","x":1922,"y":2828,"w":213,"h":32},{"text":"Subnu a second form (this side only) for alternate signers attached to this form and the argument.","x":338,"y":2898,"w":1868,"h":42}]},{"page":7,"width":2448,"height":3168,"lines":[{"text":"5m c","x":1768,"y":46,"w":219,"h":82},{"text":"Every day, thousands of San Mateo County residents rely on public transit to get to","x":301,"y":323,"w":1750,"h":48},{"text":"work, school, medical appointments, and local businesses. Our public transit system","x":297,"y":387,"w":1783,"h":48},{"text":"reduces traffic, supports our local economy, and ensures everyone has an affordable","x":301,"y":450,"w":1789,"h":48},{"text":"way to get where they need to go - including families, seniors, people with disabilities,","x":298,"y":514,"w":1809,"h":48},{"text":"students, and workers.","x":299,"y":578,"w":478,"h":43},{"text":"Today, Bay Area transit faces a turning point. Without new funding from the Regional","x":299,"y":689,"w":1786,"h":48},{"text":"Transit Measure, we will experience significant and deep cuts to our public transit","x":299,"y":753,"w":1718,"h":47},{"text":"systems -- setting us back decades. Failure of this measure could result in major station","x":301,"y":817,"w":1856,"h":47},{"text":"closures and service cuts for Caltrain, BART, Muni, and AC Transit.","x":301,"y":880,"w":1417,"h":44},{"text":"Without the Regional Transit Measure, Caltrain could close up to one-third of stations,","x":299,"y":992,"w":1812,"h":47},{"text":"reduce frequency, and stop late night and weekend service entirely. BART could cut","x":302,"y":1055,"w":1769,"h":48},{"text":"70% of their service and shut down 15 stations including Colma, San Bruno, South San","x":302,"y":1119,"w":1844,"h":47},{"text":"Francisco, and Millbrae. These cuts would disrupt daily life and push thousands more","x":302,"y":1183,"w":1802,"h":47},{"text":"cars onto Highways 101 , 280, 92, and local streets.","x":301,"y":1246,"w":1083,"h":47},{"text":"The consequences would impact everyone. This would worsen air pollution, make traffic","x":299,"y":1357,"w":1866,"h":47},{"text":"jams start earlier and last longer, and result in more time behind the wheel and less time","x":297,"y":1421,"w":1866,"h":47},{"text":"home with our families.","x":302,"y":1484,"w":485,"h":38},{"text":"The Regional Transit Measure invests directly in San Mateo County, protecting Caltrain,","x":300,"y":1596,"w":1854,"h":48},{"text":"SamTrans, and paratransit service, while preserving regional connections that","x":302,"y":1659,"w":1646,"h":48},{"text":"Peninsula residents rely on. The measure also invests money directly into San Mateo","x":304,"y":1723,"w":1799,"h":47},{"text":"County communities, making transit more reliable and efficient, repairing potholes,","x":302,"y":1786,"w":1734,"h":48},{"text":"reducing traffic, and improving safety.","x":302,"y":1850,"w":789,"h":47},{"text":"The Regional Transit Measure protects the public transit residents depend on while","x":301,"y":1962,"w":1754,"h":47},{"text":"requiring local transportation investments - with strong accountability and oversight that","x":303,"y":2025,"w":1843,"h":47},{"text":"requires large transit agencies to show cost savings to continue receiving dedicated","x":303,"y":2089,"w":1764,"h":47},{"text":"operating funding. And it doesn't tax rent, utilities, prescription medicines, or most","x":302,"y":2152,"w":1720,"h":48},{"text":"groceries.","x":302,"y":2216,"w":206,"h":47},{"text":"Please join us and vote Yes on the Regional Transit Measure.","x":305,"y":2327,"w":1299,"h":48},{"text":"www.connectbayarea.com","x":302,"y":2392,"w":557,"h":47},{"text":"12","x":2242,"y":456,"w":50,"h":48},{"text":"3","x":2239,"y":583,"w":36,"h":46},{"text":"13","x":2249,"y":677,"w":57,"h":44},{"text":"IO","x":2259,"y":873,"w":51,"h":50},{"text":"5","x":2247,"y":1041,"w":46,"h":47},{"text":"13","x":2252,"y":1102,"w":53,"h":49},{"text":"L/","x":2260,"y":1483,"w":35,"h":46},{"text":"C)","x":2268,"y":1555,"w":42,"h":46},{"text":"Io","x":2222,"y":1939,"w":50,"h":49},{"text":"Words: 297","x":302,"y":2561,"w":222,"h":35},{"text":"FILED","x":1436,"y":2533,"w":93,"h":33},{"text":"OFFICE OF THE CHIEF ELECTIONS OFFICER","x":1120,"y":2578,"w":723,"h":42},{"text":"SAN MATEO COUNTY","x":1310,"y":2630,"w":346,"h":38},{"text":"AUG O","x":1353,"y":2744,"w":122,"h":50},{"text":"OFFICER","x":1704,"y":2858,"w":147,"h":35},{"text":"DEPUTY CLERK","x":1361,"y":2982,"w":256,"h":36}]}]}
