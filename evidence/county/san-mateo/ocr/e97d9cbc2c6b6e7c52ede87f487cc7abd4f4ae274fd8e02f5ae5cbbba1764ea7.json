x":1836,"y":1761,"w":114,"h":28},{"text":"She/Her.","x":1834,"y":1801,"w":139,"h":29},{"text":"ThewtThem:","x":1834,"y":1843,"w":188,"h":29},{"text":"Pronouns:","x":1833,"y":2070,"w":160,"h":29},{"text":"He/His:","x":1832,"y":2120,"w":115,"h":32},{"text":"She/Her:","x":1832,"y":2164,"w":138,"h":29},{"text":"ThevfThem:","x":1831,"y":2205,"w":188,"h":30},{"text":"Pronouns:","x":1829,"y":2437,"w":160,"h":28},{"text":"He]His:","x":1829,"y":2489,"w":115,"h":28},{"text":"She/Her:","x":1829,"y":2530,"w":140,"h":30},{"text":"They/Them:","x":1828,"y":2572,"w":189,"h":39},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":387,"y":2638,"w":1695,"h":42}]},{"page":6,"width":2448,"height":3168,"lines":[{"text":"Final version- approved 7/19/26","x":291,"y":234,"w":618,"h":49},{"text":"ARGUMENT IN FAVOR OF MEASURE","x":290,"y":346,"w":825,"h":43},{"text":"Vote YES on Measure","x":290,"y":456,"w":431,"h":39},{"text":"to ensure that voters choose their representatives—not the other way","x":818,"y":462,"w":1314,"h":56},{"text":"around.","x":289,"y":511,"w":141,"h":36},{"text":"This measure establishes an Independent Redistricting Commission to draw County supervisorial","x":287,"y":620,"w":1866,"h":61},{"text":"district boundaries after each federal census, as provided by California law.","x":287,"y":675,"w":1441,"h":57},{"text":"Currently, the San Mateo County Board of Supervisors has final authority over district","x":285,"y":785,"w":1661,"h":59},{"text":"boundaries. But this is a self-interested group that has, most recently, overridden the","x":284,"y":840,"w":1615,"h":58},{"text":"recommendations of citizen members ofa redistricting commission. What's the point of an","x":282,"y":896,"w":1746,"h":61},{"text":"independent commission if it isn't independent? Allowing elected officials to make final","x":284,"y":950,"w":1695,"h":56},{"text":"decisions creates an inherent conflict of interest.","x":282,"y":1006,"w":923,"h":45},{"text":"A truly independent redistricting commission:","x":280,"y":1117,"w":882,"h":51},{"text":"e Reduces conflicts of interest by removing direct control from elected officials","x":282,"y":1227,"w":1527,"h":54},{"text":"e Increases transparency and public trust","x":281,"y":1283,"w":785,"h":50},{"text":"o Creates broader and more inclusive community participation.","x":281,"y":1338,"w":1213,"h":56},{"text":"Under existing 'law, the commission must follow a ranked set of criteria for redistricting. Of","x":275,"y":1446,"w":1768,"h":63},{"text":"these the highest priority is equal population. The commission must avoid splitting or diluting","x":273,"y":1503,"w":1804,"h":62},{"text":"communities of interest whenever possible, preserve the geographic integrity of cities and census","x":272,"y":1558,"w":1864,"h":59},{"text":"tracts practicable, draw districts that are contiguous with clearly identifiable boundaries,","x":271,"y":1614,"w":1821,"h":58},{"text":"and create districts that are reasonably compact. But nowhere does the law prohibit Supervisors","x":271,"y":1668,"w":1833,"h":61},{"text":"from drawing districts favoring their own re-election. A truly independent redistricting","x":273,"y":1722,"w":1663,"h":62},{"text":"commission is our best tool to keep districts competitive, so voters have meaningful choices.","x":270,"y":1778,"w":1779,"h":61},{"text":"It's time to put the public first and to create meaningful competition.","x":269,"y":1889,"w":1314,"h":58},{"text":"Vote YES on Measure","x":268,"y":2000,"w":424,"h":41},{"text":"OF THE CH!EF ELECTIONS OFFICER","x":633,"y":2391,"w":596,"h":52},{"text":"SAN","x":689,"y":2458,"w":69,"h":34},{"text":"AUG 1 1 2026","x":735,"y":2563,"w":267,"h":56},{"text":"OFFICER","x":1090,"y":2673,"w":149,"h":37},{"text":"BY","x":507,"y":2768,"w":41,"h":35},{"text":"DEPIJTY CLERK","x":746,"y":2809,"w":259,"h":36},{"text":"II","x":2267,"y":612,"w":36,"h":61},{"text":"7","x":2231,"y":1024,"w":39,"h":61},{"text":"IZ","x":2209,"y":1618,"w":51,"h":39},{"text":"II","x":2205,"y":1735,"w":31,"h":46}]}]}
