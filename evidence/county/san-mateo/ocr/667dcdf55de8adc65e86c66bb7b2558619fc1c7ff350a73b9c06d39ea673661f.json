41,"y":1664,"w":185,"h":42},{"text":"Phone:","x":238,"y":1761,"w":115,"h":29},{"text":"Address:","x":236,"y":1856,"w":147,"h":31},{"text":"Signature:","x":237,"y":1954,"w":168,"h":38},{"text":"4. Name:","x":241,"y":2054,"w":186,"h":43},{"text":"Phone:","x":239,"y":2153,"w":114,"h":29},{"text":"Address:","x":236,"y":2249,"w":148,"h":30},{"text":"Signature:","x":239,"y":2345,"w":166,"h":38},{"text":"5. Name:","x":243,"y":2446,"w":184,"h":41},{"text":"Phone:","x":240,"y":2542,"w":114,"h":29},{"text":"Address:","x":238,"y":2639,"w":146,"h":30},{"text":"Signature:","x":239,"y":2736,"w":167,"h":38},{"text":"Title:","x":1066,"y":879,"w":81,"h":30},{"text":"Director, Silicon Valle Taxpayers Associ","x":1075,"y":925,"w":694,"h":38},{"text":"Email:","x":1068,"y":975,"w":103,"h":30},{"text":"Date:","x":1069,"y":1170,"w":87,"h":29},{"text":"Aug. 11, 2026","x":1065,"y":1218,"w":239,"h":38},{"text":"Title:","x":1067,"y":1271,"w":80,"h":30},{"text":"Email:","x":1069,"y":1367,"w":102,"h":31},{"text":"Date:","x":1069,"y":1561,"w":87,"h":30},{"text":"Title:","x":1067,"y":1662,"w":80,"h":29},{"text":"Email:","x":1069,"y":1757,"w":102,"h":31},{"text":"Date:","x":1069,"y":1951,"w":88,"h":31},{"text":"Title:","x":1067,"y":2052,"w":80,"h":30},{"text":"Email:","x":1069,"y":2150,"w":103,"h":30},{"text":"Date:","x":1070,"y":2344,"w":87,"h":29},{"text":"Title:","x":1068,"y":2443,"w":81,"h":30},{"text":"Email:","x":1070,"y":2538,"w":103,"h":30},{"text":"Date:","x":1070,"y":2733,"w":88,"h":30},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":321,"y":2846,"w":1795,"h":44}]},{"page":3,"width":2448,"height":3168,"lines":[{"text":"Argument against Measure -San-Bruno-busin","x":621,"y":197,"w":863,"h":42},{"text":"[Argument starts here]","x":208,"y":339,"w":388,"h":44},{"text":"Stop this huge new tax hike!","x":922,"y":494,"w":505,"h":45},{"text":"City of San Bruno councilmembers are letting their greed show. Either that, or they don't understand the","x":277,"y":584,"w":1775,"h":59},{"text":"reality:","x":275,"y":633,"w":115,"h":41},{"text":"Businesses don 't pay taxes.","x":272,"y":732,"w":457,"h":43},{"text":"What?!","x":274,"y":828,"w":116,"h":32},{"text":"Businesses create jobs, and goods that we value, and services we need. But they have countless","x":270,"y":926,"w":1663,"h":59},{"text":"expenses and considerations, to accomplish all that.","x":270,"y":978,"w":875,"h":45},{"text":"You ask: How can it be that businesses \"don't pay taxes\"?","x":268,"y":1075,"w":995,"h":49},{"text":"Taxes are just another cost of doing business, which owners must pass along, to stay in business. They","x":266,"y":1173,"w":1770,"h":63},{"text":"pass costs along to. ..","x":265,"y":1224,"w":351,"h":40},{"text":"e Customers, through higher prices;","x":335,"y":1324,"w":640,"h":46},{"text":"Employees, through lower wages/salaries; or","x":398,"y":1376,"w":762,"h":46},{"text":"• Shareholders, through lower returns on investments (e.g., our 401 (k)s or IRAS!)","x":333,"y":1428,"w":1414,"h":56},{"text":"Remember the gigantic tariffs on imported electronics? how our favorite gadgets' prices spiked? Gadget","x":260,"y":1524,"w":1784,"h":62},{"text":"businesses necessarily passed the tariff expense along to us, through higher prices.","x":260,"y":1572,"w":1444,"h":57},{"text":"That illustrates a ftndamental law of economics","x":258,"y":1670,"w":811,"h":41},{"text":"— like gravity. But it's not just economists who feel","x":1079,"y":1681,"w":896,"h":46},{"text":"those effects in everyday activities, like shopping or filling up the tank.","x":257,"y":1718,"w":1200,"h":54},{"text":"The cost of living here is already too high. Nothing seems affordable!","x":256,"y":1816,"w":1230,"h":52},{"text":"Businesses create goods and services that people want.","x":254,"y":1914,"w":947,"h":51},{"text":"Businesses create jobs that people want.","x":253,"y":1964,"w":688,"h":47},{"text":"Their outputs are amazing — enhancing so many lives.","x":252,"y":2061,"w":931,"h":50},{"text":"Don't trust politicians who would penalize businesses","x":252,"y":2160,"w":934,"h":47},{"text":"— the engine of our extraordinary standard of","x":1196,"y":2173,"w":783,"h":46},{"text":"living — in order to fund pet projects.","x":252,"y":2208,"w":639,"h":48},{"text":"If Measure passes, San Bruno business owners who fall behind because skyrocketing taxation pushes","x":251,"y":2306,"w":1738,"h":62},{"text":"customers away, may hatch plans to relocate to cities that appreciate them more.","x":249,"y":2359,"w":1353,"h":50},{"text":"Don't tax what you want more of.","x":247,"y":2453,"w":579,"h":43},{"text":"Want more goods and services available at lower prices? Want more jobs to be available, at higher","x":247,"y":2551,"w":1675,"h":59},{"text":"wages/salaries? Then please:","x":245,"y":2600,"w":494,"h":45},{"text":"Vote NO.","x":244,"y":2699,"w":162,"h":32},{"text":"Let's not penalize job and product providers! They help us, immeasurably, every day.","x":242,"y":2798,"w":1534,"h":57},{"text":"Now let's help them:","x":239,"y":2847,"w":356,"h":41}]},{"page":4,"width":2448,"height":3168,"lines":[{"text":"Vote NO!","x":1100,"y":270,"w":171,"h":31},{"text":"Silicon Valley Taxpayer Association's volunteers advocate for taxpayers throughout San Mateo County.","x":288,"y":366,"w":1766,"h":42},{"text":"Visit SVTaxpayers.org.","x":287,"y":416,"w":391,"h":41},{"text":"[Argument ends here]","x":1780,"y":463,"w":374,"h":41}]}]}
