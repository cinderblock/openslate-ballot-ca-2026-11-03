"w":536,"h":44},{"text":"MARK CHURCH","x":1672,"y":344,"w":360,"h":47},{"text":"CHIEF ELECTIONS OFFICER &","x":1609,"y":402,"w":485,"h":40},{"text":"ASSESSOR-COUNTY CLERK-RECORDER","x":1534,"y":447,"w":634,"h":41},{"text":"Authorization Form for","x":951,"y":656,"w":569,"h":48},{"text":"Change in Signers of Rebuttal Arguments","x":717,"y":714,"w":1033,"h":60},{"text":"Pursuant to California Elections Code SS9167, 9317 and 9504, the author(s) of the primary","x":260,"y":818,"w":1794,"h":68},{"text":"argument in favor of or against a measure may authorize in writing any other person or persons to","x":258,"y":898,"w":1938,"h":64},{"text":"sign the rebuttal argument.","x":257,"y":976,"w":530,"h":48},{"text":"The undersigned author(s) of the primary argument hereby authorize(s) the following","x":254,"y":1130,"w":1808,"h":64},{"text":"individual(s) to sign (up to five) the rebuttal argument to the primary argument in favor","x":255,"y":1208,"w":1841,"h":62},{"text":"of/against (circle one) Measure W","x":254,"y":1288,"w":725,"h":50},{"text":"for the Election to be held on Nov 03, 2026","x":1140,"y":1298,"w":903,"h":44},{"text":"(date of election)","x":1849,"y":1356,"w":277,"h":42},{"text":"NEW SIGNER(S) (PRINT CLEARLY):","x":254,"y":1434,"w":759,"h":53},{"text":"Thomas Morgan","x":1006,"y":1556,"w":325,"h":46},{"text":"Name of Rebuttal Argument Signer:","x":251,"y":1561,"w":707,"h":52},{"text":"Charles Hoelter","x":1007,"y":1704,"w":312,"h":39},{"text":"Name of Rebuttal Argument Signer:","x":250,"y":1711,"w":706,"h":49},{"text":"Mark W. A. Hinkle","x":1006,"y":1854,"w":358,"h":38},{"text":"Name of Rebuttal Argument Signer:","x":248,"y":1860,"w":707,"h":47},{"text":"Name of Rebuttal Argument Signer: Francis Pardi","x":246,"y":2002,"w":1018,"h":54},{"text":"Name of Rebuttal Argument Signer:","x":246,"y":2155,"w":706,"h":48},{"text":"(The new signers listed here must sign the Ballot Measure Rebuttal Argument Submission","x":246,"y":2280,"w":1918,"h":56},{"text":"Form)","x":243,"y":2333,"w":125,"h":44},{"text":"NAME(S) & SIGNAT","x":244,"y":2435,"w":415,"h":47},{"text":"Thomas Weissmiller","x":250,"y":2526,"w":405,"h":36},{"text":"Printed Name and Sig","x":243,"y":2592,"w":433,"h":46},{"text":"Printed Name and Signature of Author","x":241,"y":2748,"w":761,"h":46},{"text":"NT AUTHOR(S):","x":1425,"y":2445,"w":331,"h":46},{"text":"Aug 18, 2026","x":1728,"y":2536,"w":267,"h":44},{"text":"Date","x":1906,"y":2604,"w":91,"h":34},{"text":"Date","x":1904,"y":2760,"w":92,"h":35},{"text":"40 Tower Road, San Mateo, CA 94402","x":864,"y":2848,"w":698,"h":41},{"text":"P 650.312.5222 F 650.312.5348 email registrar@smcacre.gov web www.smcacre.gov","x":409,"y":2894,"w":1609,"h":52}]},{"page":7,"width":2448,"height":3168,"lines":[{"text":"REBUTTAL TO ARGUMENT IN FAVOR OF MEASURE W","x":580,"y":340,"w":1232,"h":44},{"text":"FACT: The real number is $900 million, not $498 million.","x":298,"y":442,"w":1121,"h":46},{"text":"• The District's own Tax Rate Statement discloses total principal and interest at","x":362,"y":546,"w":1517,"h":52},{"text":"approximately $900 million nearfy double what proponents advertise — collected","x":432,"y":597,"w":1559,"h":49},{"text":"through fiscal year 2054-55, nearly 30 years from now.","x":432,"y":645,"w":1021,"h":48},{"text":"FACT: This is the third major bond in about a decade.","x":295,"y":744,"w":1073,"h":46},{"text":"• Measure X ($148 million, 2015) and Measure T ($409 million, 2020) already funded","x":359,"y":848,"w":1629,"h":53},{"text":"roofs, wiring, fire alarms, and safety upgrades. Ask the District what those bonds fixed","x":432,"y":898,"w":1601,"h":48},{"text":"before handing over $498 million more for the same categories of need.","x":431,"y":947,"w":1335,"h":50},{"text":"FACT: The \"project list\" is a blank check.","x":293,"y":1049,"w":825,"h":45},{"text":"• The resolution itself states project budgets are estimates that \"may be delayed or may","x":356,"y":1152,"w":1677,"h":52},{"text":"not be completed,\" and lets the Board substitute demolition for repair at its own","x":428,"y":1201,"w":1473,"h":50},{"text":"discretion. Independent oversight can confirm money was spent on the list — not that","x":427,"y":1250,"w":1594,"h":48},{"text":"your priorities were funded.","x":427,"y":1300,"w":508,"h":42},{"text":"FACT: Teacher housing, with no separate budget disclosed.","x":290,"y":1402,"w":1203,"h":48},{"text":"Bundled into this facilities bond is authority to \"construct, acquire, or contribute to","x":428,"y":1506,"w":1507,"h":49},{"text":"employee housing units\" — with no dollar figure broken out for that use alone.","x":426,"y":1556,"w":1449,"h":46},{"text":"FACT: The District's own polling found support barely above the threshold.","x":290,"y":1658,"w":1508,"h":48},{"text":"• A 2025 District-commissioned survey found only —570/0 support for this exact bond","x":354,"y":1762,"w":1602,"h":48},{"text":"amount — just above the 55% required to pass — yet the Board proceeded unchanged.","x":425,"y":1813,"w":1638,"h":49},{"text":"Other polling - cost of living is too high, taxes are out of control, and funds are so mismanaged","x":287,"y":1912,"w":1757,"h":50},{"text":"we can't trust the system.","x":285,"y":1961,"w":474,"h":43},{"text":"Vote NO on Measure W","x":951,"y":2066,"w":468,"h":36},{"text":"FILED","x":1432,"y":2381,"w":93,"h":34},{"text":"OFFICE OF THE CHIEF ELECTIONS OFFICER","x":1119,"y":2422,"w":723,"h":51},{"text":"10","x":2280,"y":771,"w":52,"h":49},{"text":"Ift","x":2290,"y":1155,"w":66,"h":64},{"text":"Idr","x":2296,"y":1220,"w":43,"h":57},{"text":"13","x":2292,"y":1490,"w":68,"h":56},{"text":"19","x":2279,"y":1740,"w":57,"h":58},{"text":"15","x":2281,"y":1810,"w":54,"h":60},{"text":"5","x":2278,"y":1988,"w":32,"h":72},{"text":"MAR","x":1124,"y":2719,"w":75,"h":34},{"text":"BY:","x":1127,"y":2792,"w":50,"h":32},{"text":"SAN MATEO COUNTY","x":1310,"y":2475,"w":345,"h":43},{"text":"AUG 1 8","x":1359,"y":2592,"w":155,"h":52},{"text":"HURCH CHIEF ELECTIONS OFFICER","x":1256,"y":2702,"w":598,"h":46},{"text":"DEPUTY CLERK","x":1364,"y":2828,"w":257,"h":39}]}]}
