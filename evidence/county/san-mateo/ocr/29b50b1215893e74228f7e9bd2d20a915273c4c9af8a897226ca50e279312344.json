w":200,"h":37},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":331,"y":2860,"w":1797,"h":40}]},{"page":3,"width":2454,"height":3168,"lines":[{"text":"ARGUMENT AGAINST MEASURE","x":252,"y":305,"w":774,"h":35},{"text":"Vote NO to Protect San Bruno's Nonprofits, Community Services, and Public Safety","x":253,"y":447,"w":1726,"h":50},{"text":"Every Fourth of July, San Bruno's nonprofit organizations raise funds that stay right here in our","x":253,"y":589,"w":1840,"h":49},{"text":"community. These local volunteers support youth sports, veterans' programs, scholarships,","x":253,"y":699,"w":1744,"h":49},{"text":"camps, school activities, community projects, and families in need. For many of these","x":255,"y":810,"w":1654,"h":49},{"text":"organizations, this is their largest fundraiser of the year.","x":254,"y":921,"w":1071,"h":47},{"text":"For years, these nonprofit organizations have done more than support community programs.","x":253,"y":1064,"w":1775,"h":48},{"text":"They have also helped fund San Bruno's Fourth of July public safety efforts, contributing tens of","x":253,"y":1175,"w":1870,"h":49},{"text":"thousands of dollars annually toward police services, fire prevention, public education,","x":253,"y":1284,"w":1676,"h":50},{"text":"inspections, enforcement, and cleanup activities.","x":255,"y":1395,"w":938,"h":45},{"text":"Everyone agrees that illegal fireworks are dangerous and should be stopped. But Measure","x":254,"y":1537,"w":1730,"h":49},{"text":"does not stop illegal fireworks. Illegal fireworks are already illegal. Criminals who ignore","x":254,"y":1648,"w":1732,"h":49},{"text":"today's laws will not obey tomorrow's ban. Instead, Measure","x":253,"y":1758,"w":1179,"h":47},{"text":"eliminates one of San Bruno 's","x":1530,"y":1762,"w":577,"h":37},{"text":"most successful nonprofit fundraising programs while the City continues to face the growing","x":254,"y":1869,"w":1790,"h":49},{"text":"challenge of illegal fireworks without the long-standing financial support provided by local","x":255,"y":1978,"w":1762,"h":51},{"text":"nonprofit organizations.","x":254,"y":2089,"w":469,"h":47},{"text":"For decades, San Bruno nonprofits have partnered with the City to strengthen our community","x":254,"y":2232,"w":1803,"h":51},{"text":"and support Fourth of July public safety efforts. Measure","x":254,"y":2341,"w":1103,"h":48},{"text":"ends that partnership,","x":1454,"y":2345,"w":410,"h":47},{"text":"does not stop illegal fireworks. It eliminates funding for local nonprofits and public","x":530,"y":2485,"w":1596,"h":51},{"text":"Measure","x":254,"y":2486,"w":164,"h":36},{"text":"safety efforts that will still be needed to protect San Bruno neighborhoods,","x":256,"y":2596,"w":1438,"h":48}]},{"page":4,"width":2454,"height":3168,"lines":[{"text":"Protect our local nonprofits. Protect the community services they provide and their support for","x":262,"y":296,"w":1808,"h":56},{"text":"San Bruno's public safuy efforts. Focus enforcement where it belongs: on illegal fireworks.","x":263,"y":407,"w":1755,"h":54},{"text":"Vote NO on Measure","x":260,"y":551,"w":404,"h":37},{"text":"Daimhin Kirwan, Commander","x":260,"y":694,"w":607,"h":44},{"text":"San Bruno Police Association","x":262,"y":836,"w":569,"h":39},{"text":"Robert Luttrell, Vice President","x":260,"y":980,"w":615,"h":44},{"text":"Parent Boosters of 72","x":260,"y":1121,"w":412,"h":39},{"text":"Jennifer Berliner, Fundraising Director","x":259,"y":1264,"w":775,"h":48},{"text":"San Bruno Youth Baseball","x":260,"y":1408,"w":504,"h":38},{"text":"Mike Yip, Fundraising Coordinator/Board Member","x":259,"y":1550,"w":991,"h":46},{"text":"SanBruno Soccer","x":260,"y":1693,"w":332,"h":35},{"text":"Stephan Marshall, San Bruno Resident","x":259,"y":1834,"w":773,"h":46}]}]}
