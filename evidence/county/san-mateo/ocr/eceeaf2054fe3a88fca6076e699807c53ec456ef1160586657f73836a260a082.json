284,"w":154,"h":31},{"text":"Signature:","x":224,"y":2383,"w":177,"h":39},{"text":"5. Name:","x":229,"y":2487,"w":192,"h":43},{"text":"Phone:","x":225,"y":2587,"w":121,"h":30},{"text":"Address:","x":222,"y":2688,"w":154,"h":30},{"text":"Signature:","x":223,"y":2787,"w":177,"h":39},{"text":"Title:","x":1095,"y":862,"w":84,"h":31},{"text":"Director, Silicon Valle","x":1103,"y":911,"w":376,"h":37},{"text":"Email:","x":1096,"y":962,"w":107,"h":31},{"text":"San Jose, CA 95110","x":761,"y":1113,"w":365,"h":37},{"text":"Date:","x":1095,"y":1164,"w":91,"h":30},{"text":"Au . 11,","x":1091,"y":1215,"w":147,"h":36},{"text":"2026","x":1252,"y":1215,"w":87,"h":32},{"text":"Title:","x":1094,"y":1270,"w":83,"h":31},{"text":"Email:","x":1095,"y":1370,"w":106,"h":30},{"text":"Date:","x":1094,"y":1570,"w":90,"h":32},{"text":"Title:","x":1091,"y":1676,"w":84,"h":31},{"text":"Email:","x":1093,"y":1777,"w":106,"h":31},{"text":"Date:","x":1092,"y":1979,"w":91,"h":30},{"text":"Title:","x":1090,"y":2083,"w":84,"h":31},{"text":"Email:","x":1091,"y":2185,"w":107,"h":31},{"text":"Date:","x":1091,"y":2384,"w":91,"h":31},{"text":"Title:","x":1089,"y":2487,"w":83,"h":31},{"text":"Email:","x":1091,"y":2586,"w":106,"h":31},{"text":"Date:","x":1090,"y":2787,"w":90,"h":30},{"text":"Taxpa ers","x":1512,"y":912,"w":187,"h":39},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":306,"y":2905,"w":1873,"h":40}]},{"page":3,"width":2448,"height":3174,"lines":[{"text":"Argument against Measure","x":611,"y":213,"w":520,"h":46},{"text":"[Argument starts here]","x":207,"y":311,"w":436,"h":46},{"text":"— Burlingame Hotel Tax Increase","x":1179,"y":213,"w":638,"h":46},{"text":"The Burlingame City Council expects voters to approve a huge, 25 PERCENT tax hike by saying","x":278,"y":408,"w":1768,"h":46},{"text":"residents won't have to pay","x":278,"y":471,"w":482,"h":41},{"text":"But they want to dramatically increase the cost of visitors' coming here for business or pleasure.","x":278,"y":560,"w":1691,"h":45},{"text":"Councilmembers are basically saying, let's discourage people from visiting and spending their","x":278,"y":652,"w":1712,"h":44},{"text":"business dollars here, gmd/gr to seeing us, their family and friends. Even when they're here to help","x":279,"y":712,"w":1793,"h":44},{"text":"while we 're in the hospital!","x":278,"y":771,"w":480,"h":42},{"text":"Does that make any sense?","x":277,"y":863,"w":472,"h":41},{"text":"Vote NO.","x":277,"y":954,"w":167,"h":32},{"text":"The ballot question says the tax would support \"maintaining city streets/ sidewalks .. .repairing","x":276,"y":1046,"w":1748,"h":49},{"text":"potholes,\" and \"enhancing emergency response, preparedness ... wildfire prevention","x":276,"y":1109,"w":1614,"h":49},{"text":"Which begs the question:","x":277,"y":1206,"w":440,"h":42},{"text":"12","x":2084,"y":651,"w":60,"h":37},{"text":"2","x":2128,"y":938,"w":38,"h":30},{"text":"t 22","x":2132,"y":1038,"w":59,"h":55},{"text":"(4","x":2173,"y":1290,"w":50,"h":45},{"text":"Why aren't such core services as police, pothole repair, and emergency response services fully covered by","x":280,"y":1297,"w":1852,"h":46},{"text":"the budget?","x":275,"y":1355,"w":203,"h":43},{"text":"Don't trust politicians!","x":275,"y":1447,"w":422,"h":42},{"text":"Budgets demonstrate our representatives' priorities. Why the heck aren't those core services the highest","x":275,"y":1538,"w":1831,"h":46},{"text":"priority, every day?","x":274,"y":1598,"w":339,"h":42},{"text":"There's no guarantee the money would reach those services, anyway — because Measure actually","x":273,"y":1690,"w":1748,"h":45},{"text":"proposes a \"general government use\" tax. So it could be diverted to literally anything the","x":273,"y":1749,"w":1578,"h":45},{"text":"councilmembers pick.","x":273,"y":1808,"w":383,"h":43},{"text":"Councilmembers should safeguard, in their regular budget, our streets, sidewalks, and emergency","x":273,"y":1899,"w":1786,"h":45},{"text":"response services.","x":274,"y":1959,"w":325,"h":42},{"text":"Don't we want more business from out-of-town visitors? more visits from loved ones?","x":272,"y":2049,"w":1527,"h":36},{"text":"It's common sense: Don't tax what you want more ofl","x":273,"y":2140,"w":956,"h":42},{"text":"Vote NO!","x":272,"y":2231,"w":169,"h":33},{"text":"Send a message to councilmembers: Don 't treat vital core services as a mere afterthought, and penalize","x":273,"y":2321,"w":1834,"h":44},{"text":"Burlingame 's visitors to cover expenses you 've overlooked!","x":271,"y":2381,"w":1045,"h":42},{"text":"Vote NO!","x":1120,"y":2471,"w":173,"h":33},{"text":"Silicon Valley Taxpayers Association's volunteers advocate for taxpayers throughout Santa Clara County.","x":272,"y":2561,"w":1854,"h":45},{"text":"12","x":2175,"y":1904,"w":62,"h":37},{"text":"7","x":2195,"y":2384,"w":33,"h":29},{"text":"7","x":2197,"y":2569,"w":41,"h":46},{"text":"2","x":2183,"y":2632,"w":46,"h":43},{"text":"Visit SVtaxpayers.org.","x":271,"y":2621,"w":390,"h":42},{"text":"RECYIVED","x":981,"y":2771,"w":335,"h":80},{"text":"2026","x":1199,"y":2879,"w":78,"h":48},{"text":"CITY CLERK'S OFFIC","x":965,"y":2966,"w":350,"h":39},{"text":"CITY OF BURLINGAM","x":964,"y":3002,"w":352,"h":38},{"text":"[Argument ends here]","x":1814,"y":2712,"w":420,"h":45}]}]}
