564,"h":48},{"text":"The undersigned author(s) of the primary argument hereby authorize(s) the followin","x":225,"y":1079,"w":1900,"h":53},{"text":"individual(s) to sign (up to five) the rebuttal argument to the primary argume t in favor","x":226,"y":1160,"w":1963,"h":54},{"text":"of/against (circle one) Measure E","x":224,"y":1240,"w":762,"h":53},{"text":"for the Election to be held on Novembe","x":1169,"y":1243,"w":893,"h":44},{"text":"26","x":2199,"y":1246,"w":51,"h":36},{"text":"(date of election)","x":1931,"y":1304,"w":292,"h":41},{"text":"NEW SIGNER(S) (PRINT CLEARLY):","x":224,"y":1399,"w":809,"h":51},{"text":"Name of Rebuttal Argument Signer:","x":223,"y":1535,"w":751,"h":48},{"text":"Name of Rebuttal Argument Signer:","x":221,"y":1693,"w":752,"h":50},{"text":"Name of Rebuttal Argument Signer:","x":219,"y":1850,"w":753,"h":50},{"text":"Name of Rebuttal Argument Signer:","x":218,"y":2009,"w":752,"h":50},{"text":"Name of Rebuttal Argument Signer:","x":216,"y":2167,"w":755,"h":50},{"text":"Diane Howard, Redwood City Councilmember","x":1035,"y":1524,"w":977,"h":49},{"text":"Michael Elhihi, Redwood City Firefighters","x":1033,"y":1680,"w":871,"h":50},{"text":"Erik Otterson, Redwood City Police Officers Assoc.","x":1032,"y":1840,"w":1076,"h":47},{"text":"Ernie Schmidt, Small Business Owner","x":1031,"y":2000,"w":807,"h":45},{"text":"Jeri Richardson-Daines, Small Housing Provider","x":1029,"y":2160,"w":1027,"h":48},{"text":"(The new signers listed here must sign the Ballot Measure Rebuttal Argument Submission","x":215,"y":2302,"w":2053,"h":53},{"text":"Form)","x":214,"y":2358,"w":131,"h":47},{"text":"NAME(S) & SIGNATURE(S)","x":214,"y":2468,"w":606,"h":49},{"text":"Elmer Martinez Saballos","x":226,"y":2562,"w":516,"h":39},{"text":"Printed Name","x":213,"y":2633,"w":287,"h":38},{"text":"Isabella Chu","x":225,"y":2729,"w":260,"h":37},{"text":"Printed Name","x":211,"y":2799,"w":288,"h":38},{"text":"P 650.312.5222","x":388,"y":2954,"w":310,"h":37},{"text":"AUTHOR(S):","x":1553,"y":2474,"w":282,"h":48},{"text":"8.18.2026","x":1813,"y":2568,"w":210,"h":37},{"text":"Date","x":1996,"y":2640,"w":96,"h":37},{"text":"8.18.2026","x":1812,"y":2736,"w":210,"h":36},{"text":"Date","x":1997,"y":2806,"w":94,"h":37},{"text":"40 Tower Road, San Mateo, CA 94402","x":876,"y":2904,"w":751,"h":43},{"text":"F 650.312.5348 email registrar@smcacre.gov web www.smcacre.gov","x":726,"y":2956,"w":1389,"h":47}]},{"page":7,"width":2448,"height":3168,"lines":[{"text":"REBUTTAL TO ARGUMENT IN FAVOR OF MEASURE E","x":676,"y":285,"w":1113,"h":36},{"text":"Small housing providers, affordable housing nonprofits, small businesses, first responders and","x":300,"y":457,"w":1823,"h":46},{"text":"the Redwood City Council oppose Measure E for the same underlying reasons: Measure E's","x":298,"y":515,"w":1800,"h":48},{"text":"unintende consequences will put essential City programs and services at risk, and","x":300,"y":571,"w":1743,"h":49},{"text":"reduce housing affordability and choice.","x":300,"y":632,"w":839,"h":44},{"text":"Measure E is costly. Two independent financial analyses found administering this program","x":298,"y":749,"w":1787,"h":48},{"text":"cou d cost up to $11 million per year and require 18 new full-time employees. Fees could reach","x":297,"y":809,"w":1833,"h":51},{"text":"$757 per rental unit with the gap diverted from other Citv departments, such as police and fire.","x":297,"y":863,"w":1818,"h":51},{"text":"This is not a \"small fee.\"","x":295,"y":926,"w":488,"h":37},{"text":"Measure E is a sharp departure from other cities by not exempting affordable","x":296,"y":1047,"w":1679,"h":48},{"text":"housing nonprofits. Nonprofits like the St. who have spent decades providing","x":296,"y":1107,"w":1854,"h":48},{"text":"and preserving affordable homes, would face the same fees as corporate landlords, threatening","x":294,"y":1168,"w":1851,"h":47},{"text":"their ability to maintain buildings and fund resident services.","x":293,"y":1226,"w":1156,"h":44},{"text":"Measure E applies to every apartment, single family home, in-law and nonprofit","x":295,"y":1342,"w":1651,"h":45},{"text":"affordable housing unit in Redwood City. It requires between in","x":292,"y":1402,"w":1663,"h":45},{"text":"relocation payments to move back in, or renovate your home. Any change or fix to Measure","x":294,"y":1461,"w":1826,"h":48},{"text":"E requires another costly citywide election.","x":293,"y":1521,"w":826,"h":44},{"text":"With no General Fund backstop, an unproven program with an $11 million price tag could mean","x":290,"y":1637,"w":1851,"h":46},{"text":"real cuts to police, fire and services our neighborhoods depend on. This measure risks our","x":292,"y":1696,"w":1754,"h":45},{"text":"safety net and the affordable housing it claims to protect.","x":290,"y":1754,"w":1098,"h":45},{"text":"Don't trade affordable housing, City services and safe neighborhoods for a flawed measure.","x":291,"y":1871,"w":1775,"h":45},{"text":"Vote NO on Measure E.","x":287,"y":1987,"w":462,"h":35},{"text":"RECEIVED","x":1522,"y":2318,"w":301,"h":63},{"text":"AUG 18 2026","x":1548,"y":2472,"w":257,"h":51},{"text":"'itdvvoou","x":1628,"y":2565,"w":121,"h":29},{"text":"City Clerk","x":1593,"y":2618,"w":137,"h":33},{"text":"II","x":2389,"y":751,"w":30,"h":55},{"text":"299>","x":2267,"y":2080,"w":154,"h":57}]}]}
