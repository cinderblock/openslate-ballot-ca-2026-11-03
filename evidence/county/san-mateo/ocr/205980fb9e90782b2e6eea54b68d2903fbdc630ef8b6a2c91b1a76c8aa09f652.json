ated teachers.","x":327,"y":2145,"w":359,"h":33},{"text":"Strong local high schools benefit the entire community and help protect local property values.","x":327,"y":2249,"w":1691,"h":41},{"text":"Measure _ helps keep dedicated educators, and prepare graduates for college, careers and","x":325,"y":2300,"w":1722,"h":41},{"text":"the future.","x":325,"y":2350,"w":183,"h":32},{"text":"Join parents, teachers, graduates, seniors and community leaders in voting YES on Measure","x":325,"y":2454,"w":1748,"h":41},{"text":"FILED","x":1491,"y":2583,"w":92,"h":36},{"text":"OFF'tCE OF THE CHIEF ELECTIONS OFFICER","x":1174,"y":2620,"w":722,"h":61},{"text":"SAN MATEO COIF(","x":1361,"y":2678,"w":347,"h":45},{"text":"•zsz","x":1976,"y":2702,"w":231,"h":86},{"text":"AUG 1 2026","x":1400,"y":2794,"w":262,"h":54},{"text":"FFICER","x":1770,"y":2923,"w":121,"h":38},{"text":"CLERK","x":1539,"y":3037,"w":111,"h":35},{"text":"7","x":2260,"y":870,"w":38,"h":56},{"text":"13","x":2266,"y":1119,"w":44,"h":53},{"text":"6","x":2270,"y":1243,"w":29,"h":53},{"text":"6","x":2265,"y":1482,"w":31,"h":64},{"text":"3","x":2269,"y":1930,"w":33,"h":52},{"text":"(3","x":2267,"y":2447,"w":57,"h":62}]}]}
