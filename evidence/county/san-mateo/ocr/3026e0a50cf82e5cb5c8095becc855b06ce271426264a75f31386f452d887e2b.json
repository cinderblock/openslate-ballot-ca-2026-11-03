{"engine":"Windows.Media.Ocr en-US","scale":3,"pages":[{"page":1,"width":2448,"height":3168,"lines":[{"text":"OF","x":355,"y":185,"w":42,"h":29},{"text":"CITY OF HALF MOON B/»","x":1105,"y":154,"w":615,"h":55},{"text":"OFFICE OF","x":616,"y":213,"w":246,"h":37},{"text":"ASSESSOR-COUNTY CLERKIIJG 6 2026","x":615,"y":275,"w":927,"h":64},{"text":"MARK CHURCH","x":1675,"y":262,"w":372,"h":44},{"text":"CHIEF ELECTIONS OFFICER &","x":1614,"y":323,"w":495,"h":35},{"text":"RECORDER & ELECTIONS","x":617,"y":349,"w":594,"h":48},{"text":"ASSESSOR-COUNTY CLERK-RECORDER","x":1536,"y":369,"w":651,"h":35},{"text":"COUNTY OF SAN MAT8F10E OF THE CITY CLERK","x":616,"y":425,"w":1124,"h":71},{"text":"Ballot Measure Primary Argument Submission Form","x":568,"y":532,"w":1326,"h":52},{"text":"A ballot argument will not be accepted unless accompanied by this completed typed form, which shall contain the","x":234,"y":588,"w":1921,"h":42},{"text":"printed name(s) and signature(s) of the person(s) submitting it or, if submitted on behalf of a bona fide association of","x":236,"y":632,"w":1967,"h":43},{"text":"citizens, the name of the association and the printed name and signature of at least one of its principal officers.","x":235,"y":677,"w":1871,"h":40},{"text":"Please make sure you are using proper format before submitting to the Elections Office.","x":237,"y":723,"w":1596,"h":40},{"text":"Word count limit for Primary Arguments = 300 words","x":235,"y":784,"w":885,"h":39},{"text":"for the City of Half Moon Bay","x":813,"y":837,"w":496,"h":37},{"text":"Ballot Measure Measure D","x":237,"y":839,"w":453,"h":37},{"text":"to be held on Nov. 03, 2026","x":1470,"y":836,"w":475,"h":36},{"text":"Primary Argument in Favor of","x":300,"y":911,"w":500,"h":40},{"text":"Primary Argument Against","x":1092,"y":910,"w":446,"h":38},{"text":"This argument is submitted by (check ONLY ONE):","x":771,"y":980,"w":921,"h":40},{"text":"The County of San Mateo Board of Supervisors or the Governing Body of a Schoo