553,"y":1934,"w":401,"h":35},{"text":"Signatur","x":252,"y":1988,"w":147,"h":38},{"text":"4. N me:","x":254,"y":2091,"w":196,"h":44},{"text":"5.","x":255,"y":2509,"w":30,"h":30},{"text":"Sig","x":251,"y":2798,"w":55,"h":38},{"text":"Title:","x":1113,"y":2088,"w":83,"h":30},{"text":"Date:","x":1113,"y":2389,"w":91,"h":30},{"text":"CIS o","x":1193,"y":2434,"w":141,"h":41},{"text":"Title:","x":1112,"y":2494,"w":84,"h":29},{"text":"Date.","x":1113,"y":2795,"w":91,"h":31},{"text":"zC2(-c","x":1467,"y":1195,"w":218,"h":63},{"text":"of San Mateo","x":1472,"y":1328,"w":235,"h":31},{"text":"H ROO b","x":1439,"y":2806,"w":364,"h":73},{"text":"Submit a second form (this side only) for alternate","x":334,"y":2914,"w":951,"h":41},{"text":"igners attached to this form and the argument.","x":1319,"y":2912,"w":876,"h":41}]},{"page":3,"width":2448,"height":3168,"lines":[{"text":"Vote YES to Update San Mateo's City Charter","x":276,"y":413,"w":947,"h":43},{"text":"San Mateo'sCity Charter establishes the basic rules for how our local government operates.","x":278,"y":520,"w":1786,"h":43},{"text":"Portions were written decades ago and no longer reflect California law or how our City operates","x":278,"y":578,"w":1847,"h":42},{"text":"today.","x":277,"y":638,"w":117,"h":42},{"text":"These are practical, commonsense updates.","x":276,"y":744,"w":865,"h":41},{"text":"Voting YES will formally update the Charter to reflect San Mateo's district-based elections and","x":276,"y":848,"w":1819,"h":44},{"text":"require district boundaries to be reviewed after each federal census.","x":278,"y":907,"w":1317,"h":43},{"text":"It will also make straightforward administrative changes, including providing additional time to fill","x":280,"y":1011,"w":1849,"h":45},{"text":"a vacant City Council—eat and allowing the Council to set the day and time of regular meetings","x":277,"y":1070,"w":1835,"h":49},{"text":"by public resolution rather than permanently fixing them in the Charter.","x":278,"y":1129,"w":1367,"h":44},{"text":"The measure also removes outdated provisions from our formenat-large election system and","x":276,"y":1234,"w":1797,"h":44},{"text":"language no longer required under state law.","x":278,"y":1295,"w":869,"h":43},{"text":"sn Mateo is one of only two charter cities in San Mateo County- Having our own Charter gives","x":267,"y":1381,"w":1854,"h":63},{"text":"residents important local control over how our City is governed. With that privilege comes a","x":278,"y":1453,"w":1757,"h":48},{"text":"responsibility to periodically update it so our rules remain clear, legally compliant, and relevant.","x":278,"y":1515,"w":1830,"h":45},{"text":"These changes don't raise taxes, create new programs, or fundamentally change how our City","x":276,"y":1620,"w":1827,"h":46},{"text":"is governed. They simply make our Charter clearer, more practical, and consistent with current","x":278,"y":1680,"w":1826,"h":45},{"text":"law and how San Mateooperates today.","x":278,"y":1740,"w":781,"h":42},{"text":"This is a straightfotward update to a document that should accurately reflect the community and","x":276,"y":1843,"w":1851,"h":45},{"text":"government it serves.","x":277,"y":1905,"w":419,"h":42},{"text":"Please join us in voting YES to update San Mateo's City Charter.","x":278,"y":2008,"w":1300,"h":44},{"text":"3","x":2257,"y":830,"w":49,"h":66}]}]}
