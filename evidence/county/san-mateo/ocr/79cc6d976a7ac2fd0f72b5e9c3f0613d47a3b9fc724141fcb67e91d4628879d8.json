"text":"94303","x":894,"y":1052,"w":100,"h":27},{"text":"Date:","x":1108,"y":1098,"w":83,"h":28},{"text":"Title:","x":1106,"y":1194,"w":77,"h":29},{"text":"Email:","x":1107,"y":1286,"w":98,"h":29},{"text":"Date:","x":1106,"y":1470,"w":84,"h":29},{"text":"Title:","x":1104,"y":1567,"w":77,"h":28},{"text":"Email:","x":1104,"y":1660,"w":99,"h":28},{"text":"Date:","x":1103,"y":1844,"w":84,"h":29},{"text":"Title:","x":1102,"y":1940,"w":76,"h":29},{"text":"Email:","x":1102,"y":2034,"w":98,"h":30},{"text":"Date:","x":1101,"y":2219,"w":84,"h":29},{"text":"Title:","x":1097,"y":2314,"w":78,"h":32},{"text":"Email:","x":1100,"y":2408,"w":98,"h":30},{"text":"Date:","x":1099,"y":2595,"w":84,"h":28},{"text":"ofruer- a","x":1239,"y":828,"w":483,"h":36},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":374,"y":2705,"w":1727,"h":39}]},{"page":7,"width":2436,"height":3156,"lines":[{"text":"Vote Yes on Measure _ : protect affordable college education, maintain quality job training,","x":283,"y":245,"w":1856,"h":48},{"text":"and repair aging classrooms and labs, all without raisin taxes b a","x":285,"y":298,"w":1349,"h":46},{"text":"A UC or CSU degree shouldn't come with a lifetlme of debt. That's why 420/0 of local high school","x":279,"y":384,"w":1811,"h":49},{"text":"graduates choose College of San Mateo, Cafiada College, and Skyline College instead — the same","x":282,"y":437,"w":1797,"h":48},{"text":"quality education and job training, without the sky-high price tag.","x":283,"y":492,"w":1202,"h":48},{"text":"Local community colleges are the backbone of our economy, tralnlng the nurses who care for us,","x":282,"y":577,"w":1793,"h":47},{"text":"the firefighters who keep us safe, and the skilled workers who power local industries. For students","x":283,"y":630,"w":1811,"h":48},{"text":"seeking hands-on, vocational training to land good-paying careers, these campuses are irreplaceable.","x":283,"y":685,"w":1839,"h":48},{"text":"Yet, many campus buildings are more than 50 years old and have never been updated. They don't","x":281,"y":770,"w":1801,"h":48},{"text":"meet modern safety codes, are in urgent need of repairs, and haven't kept pace with industry","x":279,"y":824,"w":1708,"h":47},{"text":"standards for job training.","x":282,"y":878,"w":476,"h":45},{"text":"That's why we need Measure . It provides dedicated, local funding for San Mateo County","x":280,"y":985,"w":1696,"h":48},{"text":"Community College DistHct that can't be taken by the State or Federal Government.","x":281,"y":1038,"w":1563,"h":47},{"text":"And it does so by Simply continuing the current tax rate.","x":278,"y":1146,"w":1043,"h":48},{"text":"Yes on : Affordable Higher Education & Job Training Without Increasing Taxes","x":278,"y":1232,"w":1671,"h":48},{"text":"• Remove hazardous materials like asbestos and lead pipes","x":351,"y":1286,"w":1119,"h":46},{"text":"• Repair deteriorated roofs, plumbing, heating, ventilation, and gas, sewer, and electrical","x":351,"y":1340,"w":1659,"h":47},{"text":"systems","x":420,"y":1400,"w":140,"h":37},{"text":"• Modernize career training facilities, labs, and equipment for In-demand fields like nursing,","x":351,"y":1446,"w":1724,"h":50},{"text":"engineering, technology, public safety, and skilled trades","x":419,"y":1501,"w":1036,"h":47},{"text":"A Transparent System of Accountability:","x":276,"y":1607,"w":816,"h":46},{"text":"• A detailed project list outlines how funds will be spent","x":348,"y":1662,"w":1080,"h":47},{"text":"• Independent oversight and annual audits are required","x":348,"y":1717,"w":1059,"h":47},{"text":"• All funds stay in San Mateo County — the State and Federal Government can't touch","x":348,"y":1769,"w":1657,"h":47},{"text":"Measure","x":417,"y":1824,"w":156,"h":32},{"text":"San Mateo County community colleges give thousands of lower- and middle-income","x":277,"y":1931,"w":1700,"h":47},{"text":"students an opportunity for future success. Let's protect this resource, without increasing","x":276,"y":1986,"w":1794,"h":49},{"text":"taxes: Vote Yes on !","x":275,"y":2040,"w":439,"h":35},{"text":"FILED","x":988,"y":2280,"w":93,"h":34},{"text":"GCFICE OF THE CHIEF ELECTIONS OFFICER","x":673,"y":2324,"w":726,"h":45},{"text":"SAN WITEO","x":863,"y":2379,"w":195,"h":36},{"text":"AUG II 2026","x":906,"y":2490,"w":263,"h":51},{"text":"OFFICER","x":1258,"y":2604,"w":147,"h":35},{"text":"BY:","x":675,"y":2688,"w":49,"h":33},{"text":"DEPUTY CLERK","x":912,"y":2730,"w":258,"h":36},{"text":"13","x":2238,"y":229,"w":66,"h":63},{"text":"16","x":2249,"y":531,"w":58,"h":44},{"text":"5","x":2336,"y":1712,"w":28,"h":69},{"text":"7","x":2341,"y":1850,"w":35,"h":52}]}]}
