 Pamphlets.","x":778,"y":2774,"w":862,"h":43},{"text":"Please complete the reverse side of this form.","x":776,"y":2824,"w":866,"h":40},{"text":"40 Tower Road, San Mateo, CA 94402","x":834,"y":2874,"w":747,"h":41},{"text":"P 650.312.5222 F 650.312.5348 email registrar@smcacre.gov web www.smcacre.gov","x":350,"y":2924,"w":1717,"h":51}]},{"page":2,"width":2436,"height":3156,"lines":[{"text":"Primary Argument Signers Form","x":717,"y":116,"w":616,"h":39},{"text":"No more than five signatures shall appear with any argument. If more than five signatures","x":212,"y":174,"w":1590,"h":44},{"text":"are submitted, the first five listed shall be printed. Names and titles listed will be printed in","x":210,"y":220,"w":1586,"h":43},{"text":"the order that they are listed below. Place a checkmark in the author column if the signer is","x":209,"y":266,"w":1614,"h":44},{"text":"the author of the argument. A signer can only list one title. Honorifics such as M.D., Dr.,","x":208,"y":312,"w":1561,"h":41},{"text":"Esquire, etc. with a name are not accepted.","x":211,"y":358,"w":765,"h":39},{"text":"If the signers are part of a bona fide association, there is no requirement that they be","x":211,"y":427,"w":1491,"h":44},{"text":"eligible to vote on the measure. However, for each such signing individual, the title under","x":209,"y":472,"w":1577,"h":43},{"text":"the signer's name must list the name of that bona fide association and may include their","x":208,"y":518,"w":1551,"h":43},{"text":"position within that association.","x":209,"y":564,"w":546,"h":39},{"text":"By signing below, the undersigned state that they have read the argument and believe it not","x":209,"y":634,"w":1617,"h":43},{"text":"Author","x":1892,"y":120,"w":133,"h":31},{"text":"o","x":1903,"y":231,"w":23,"h":20},{"text":"Pronouns:","x":1878,"y":1018,"w":178,"h":32},{"text":"He/His:","x":1878,"y":1076,"w":126,"h":34},{"text":"She/Her:","x":1876,"y":1123,"w":154,"h":32},{"text":"The /Them:","x":1875,"y":1169,"w":209,"h