ext":"Date:","x":1111,"y":1937,"w":87,"h":30},{"text":"Title:","x":1109,"y":2037,"w":80,"h":30},{"text":"Email:","x":1110,"y":2134,"w":101,"h":31},{"text":"Date:","x":1109,"y":2327,"w":88,"h":29},{"text":"Title:","x":1107,"y":2427,"w":80,"h":29},{"text":"Email:","x":1108,"y":2522,"w":101,"h":31},{"text":"Date:","x":1107,"y":2717,"w":87,"h":30},{"text":"Author","x":1900,"y":199,"w":126,"h":29},{"text":"Verified","x":2090,"y":200,"w":140,"h":29},{"text":"o","x":2153,"y":299,"w":23,"h":20},{"text":"00","x":2100,"y":614,"w":74,"h":31},{"text":"LL c","x":2100,"y":800,"w":118,"h":23},{"text":"pJ4","x":2085,"y":875,"w":137,"h":81},{"text":"Pronouns:","x":1886,"y":1067,"w":170,"h":31},{"text":"He/His:","x":1886,"y":1123,"w":120,"h":30},{"text":"She/Her:","x":1885,"y":1167,"w":147,"h":31},{"text":"They/ Them:","x":1883,"y":1212,"w":203,"h":37},{"text":"Pronouns:","x":1884,"y":1456,"w":170,"h":31},{"text":"He/His:","x":1883,"y":1512,"w":122,"h":31},{"text":"She/Her:","x":1882,"y":1555,"w":149,"h":31},{"text":"They/Them:","x":1882,"y":1600,"w":202,"h":37},{"text":"Pronouns:","x":1882,"y":1845,"w":170,"h":30},{"text":"He/His:","x":1882,"y":1900,"w":120,"h":30},{"text":"She/Her:","x":1880,"y":1943,"w":148,"h":32},{"text":"They/Them:","x":1879,"y":1989,"w":202,"h":37},{"text":"Pronouns:","x":1880,"y":2235,"w":171,"h":29},{"text":"He/His:","x":1880,"y":2289,"w":121,"h":31},{"text":"She/Her:","x":1879,"y":2333,"w":147,"h":31},{"text":"They/Them:","x":1877,"y":2378,"w":203,"h":37},{"text":"Pronouns:","x":1878,"y":2624,"w":170,"h":30},{"text":"He/His:","x":1878,"y":2679,"w":120,"h":31},{"text":"She/Her:","x":1877,"y":2723,"w":147,"h":32},{"text":"They/Them:","x":1875,"y":2769,"w":203,"h":37},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":354,"y":2829,"w":1793,"h":46}]},{"page":7,"width":2448,"height":3168,"lines":[{"text":"ARGUMENT AGAINST REGIONAL TRANSIT MEASURE","x":529,"y":131,"w":1238,"h":42},{"text":"• The five-county Regional Transit Measure's (RTM's) tax increase is a $14 billion-dollar","x":273,"y":278,"w":1751,"h":49},{"text":"bailout for a broken system with irresponsible management. Promised oversight is toothless.","x":328,"y":333,"w":1810,"h":48},{"text":"We must demand accountability and structural reform, not ask taxpayers to shoulder yet","x":327,"y":388,"w":1702,"h":47},{"text":"another heavy new tax burden. DEMAND FIXES BEFORE NEW FUNDING!","x":328,"y":443,"w":1491,"h":48},{"text":"• RTM expects working families to pay for ongoing mismanagement. Grand Juries in Alameda","x":275,"y":553,"w":1847,"h":48},{"text":"County, Contra Costa County, and Santa Clara County have found major transit-management","x":330,"y":610,"w":1808,"h":47},{"text":"and financial-oversight flaws. Since 2019, ridership at the major transit agencies has fallen","x":331,"y":663,"w":1835,"h":47},{"text":"51%, yet expenses have risen 28%. Sales taxes grow with inflation, so why has Transit","x":331,"y":719,"w":1735,"h":48},{"text":"outspent even its new revenues?","x":331,"y":776,"w":638,"h":45},{"text":"• Sales taxes are regressive, hitting lower-income residents the hardest. California's rates,","x":278,"y":885,"w":1877,"h":47},{"text":"often exceeding an effective 9.25% statutory limit, are among America's highest. RTM would","x":331,"y":938,"w":1793,"h":47},{"text":"raise sales taxes in 12 San Mateo County cities above 10%. While families tighten belts,","x":332,"y":993,"w":1712,"h":46},{"text":"transit agencies want blank checks without addressing their administrative bloat.","x":331,"y":1048,"w":1549,"h":48},{"text":"• We need Fixes Before New Funding, not higher taxes to sustain the inefficient status quo.","x":278,"y":1160,"w":1818,"h":46},{"text":"• RTM exploits a loophole to bypass statutory taxpayer protections, attempting to pass this","x":279,"y":1272,"w":1858,"h":48},{"text":"new tax hike with a mere 50% +1 majority instead of the traditional two-thirds requirement.","x":334,"y":1326,"w":1740,"h":46},{"text":"• Furthermore, this tax underwrites continuation of capital-intensive mega-projects. These are","x":280,"y":1438,"w":1840,"h":45},{"text":"routinely years late, way over budget, yet deliver less than 20% of the promised ridership.","x":335,"y":1492,"w":1803,"h":48},{"text":"Instead of propping up outdated transit modes, agencies must adapt to modern commuting","x":336,"y":1547,"w":1751,"h":48},{"text":"realities and reallocate existing capital funds to cover shortfalls.","x":336,"y":1603,"w":1314,"h":45},{"text":"• This regional tax also extracts local dollars to subsidize inefficiencies elsewhere. Most new","x":282,"y":1713,"w":1815,"h":48},{"text":"RTM taxes from San Mateo County would go to fund transit agencies serving other","x":337,"y":1768,"w":1682,"h":46},{"text":"counties, like San Francisco.","x":336,"y":1825,"w":571,"h":43},{"text":"• Don't reward budgetary negligence. Reform Bay Area Transit by rejecting this tax and","x":283,"y":1934,"w":1764,"h":46},{"text":"forcing fiscal discipline.","x":335,"y":1992,"w":446,"h":44},{"text":"Vote NO on the Regional Transit Measure","x":803,"y":2098,"w":853,"h":44},{"text":"IO","x":2274,"y":457,"w":47,"h":47},{"text":"13","x":2270,"y":532,"w":52,"h":49},{"text":"13","x":2254,"y":925,"w":50,"h":54},{"text":"-D","x":2244,"y":995,"w":58,"h":51},{"text":"Io","x":2245,"y":1048,"w":54,"h":52},{"text":"9","x":2209,"y":1609,"w":32,"h":68},{"text":"3","x":2184,"y":1828,"w":35,"h":48},{"text":"3","x":2180,"y":1995,"w":38,"h":59},{"text":"NoNewTransitTax.com","x":1001,"y":2185,"w":461,"h":35},{"text":"FILED","x":1021,"y":2417,"w":94,"h":34},{"text":"OFFICE OF CHIEF ELECTIONS OFFICER","x":706,"y":2458,"w":726,"h":51},{"text":"COUNTY","x":1104,"y":2513,"w":141,"h":37},{"text":"AUG 2026","x":944,"y":2626,"w":262,"h":53},{"text":"FICER","x":1342,"y":2738,"w":101,"h":34},{"text":"DEPUTY'","x":952,"y":2869,"w":136,"h":35},{"text":"6","x":1997,"y":2419,"w":55,"h":75}]}]}
