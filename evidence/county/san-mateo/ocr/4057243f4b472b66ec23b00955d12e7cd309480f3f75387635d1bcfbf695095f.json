{"text":"Email:","x":1127,"y":2576,"w":102,"h":32},{"text":"Date:","x":1131,"y":2771,"w":88,"h":31},{"text":"Pronouns:","x":1879,"y":1105,"w":172,"h":30},{"text":"He/His:","x":1880,"y":1159,"w":123,"h":33},{"text":"She/Her:","x":1880,"y":1205,"w":149,"h":32},{"text":"TheyfThem:","x":1880,"y":1249,"w":204,"h":38},{"text":"Pronouns:","x":1885,"y":1494,"w":174,"h":31},{"text":"He/His:","x":1887,"y":1548,"w":123,"h":34},{"text":"She/Her:","x":1887,"y":1592,"w":149,"h":34},{"text":"The /Them:","x":1886,"y":1637,"w":204,"h":33},{"text":"Pronouns:","x":1893,"y":1884,"w":173,"h":32},{"text":"He/His:","x":1893,"y":1938,"w":124,"h":33},{"text":"She/Her:","x":1893,"y":1982,"w":151,"h":34},{"text":"The [Them:","x":1893,"y":2028,"w":205,"h":32},{"text":"Pronouns:","x":1900,"y":2274,"w":173,"h":30},{"text":"He/HiS:","x":1901,"y":2328,"w":123,"h":34},{"text":"She/Her:","x":1901,"y":2372,"w":150,"h":33},{"text":"The /Them:","x":1901,"y":2416,"w":205,"h":34},{"text":"Pronouns:","x":1906,"y":2664,"w":174,"h":30},{"text":"He/His:","x":1908,"y":2717,"w":124,"h":34},{"text":"She/Her:","x":1909,"y":2762,"w":149,"h":33},{"text":"The /Them:","x":1908,"y":2805,"w":205,"h":34},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":380,"y":2873,"w":1804,"h":58}]},{"page":3,"width":2448,"height":3168,"lines":[{"text":"Ballot Argument Against Term Limits—Measure","x":416,"y":291,"w":1448,"h":61},{"text":"East Palo Alto already has term limits. It's called voting out your city","x":262,"y":421,"w":1562,"h":53},{"text":"representatives when they are not meeting the community's needs. Vote No on","x":261,"y":481,"w":1823,"h":53},{"text":"Measure","x":260,"y":541,"w":197,"h":39},{"text":"We already have that opportunity every two years in November. EPA voters","x":257,"y":660,"w":1749,"h":52},{"text":"have on numerous occasions not reelected councilmembers, selecting other","x":259,"y":720,"w":1746,"h":53},{"text":"candidates instead. Don't be fooled into voting for a law limiting the people's","x":258,"y":780,"w":1754,"h":53},{"text":"choice. Vote No on Measure","x":258,"y":840,"w":653,"h":40},{"text":"San Mateo County has 20 cities. There's a sound reason why only 6 cities have","x":257,"y":959,"w":1824,"h":54},{"text":"term limits and 14 cities, a supermajority, do not. East Palo Altans disadvantage","x":256,"y":1019,"w":1830,"h":54},{"text":"ourselves with term limits, handicapping our seasoned elected representatives","x":257,"y":1080,"w":1793,"h":51},{"text":"from holding leadership positions on vital regional bodies. It takes time to be","x":255,"y":1139,"w":1741,"h":51},{"text":"known and supported countywide by electeds. This measure gets in the way of","x":257,"y":1199,"w":1808,"h":53},{"text":"that. Vote No on Measure","x":255,"y":1258,"w":590,"h":40},{"text":"EPA is a small city that punches above its weight precisely because our","x":258,"y":1379,"w":1642,"h":53},{"text":"representatives are more likely able to hold regional positions. Let's keep it that","x":257,"y":1438,"w":1825,"h":53},{"text":"way","x":253,"y":1508,"w":91,"h":39},{"text":"If you don't like an elected official, just vote them out of office. Don't limit the","x":258,"y":1618,"w":1747,"h":52},{"text":"people's ability to vote for someone with proven and effective experience and","x":256,"y":1678,"w":1765,"h":53},{"text":"who they trust is doing a good job. That is what this measure will do if passed. It","x":253,"y":1738,"w":1847,"h":54},{"text":"13","x":2195,"y":954,"w":47,"h":54},{"text":"{3","x":2198,"y":1139,"w":43,"h":47},{"text":"13","x":2199,"y":1440,"w":35,"h":41},{"text":"(9","x":2200,"y":1810,"w":34,"h":57},{"text":"hurts EPA. Vote No on Measure","x":256,"y":1799,"w":735,"h":40},{"text":"End","x":1243,"y":1829,"w":130,"h":74},{"text":"Is/ Javanni Brown; Ravneel Chaudhary; Luis Rosas","x":253,"y":1978,"w":1183,"h":51},{"text":"21b","x":1947,"y":1992,"w":143,"h":85}]}]}
