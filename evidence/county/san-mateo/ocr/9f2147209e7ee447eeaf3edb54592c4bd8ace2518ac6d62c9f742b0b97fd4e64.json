xt":"Email:","x":1100,"y":2194,"w":105,"h":30},{"text":"CA 94019","x":921,"y":2343,"w":177,"h":31},{"text":"Date:","x":1099,"y":2395,"w":90,"h":31},{"text":"August 6, 2026","x":1096,"y":2444,"w":265,"h":39},{"text":"Title:","x":1097,"y":2499,"w":84,"h":31},{"text":"City Councilman-acting as private citizen","x":1106,"y":2548,"w":714,"h":38},{"text":"Email:","x":1100,"y":2599,"w":105,"h":31},{"text":"Date:","x":1099,"y":2802,"w":91,"h":31},{"text":"ugust 6, 2026","x":1124,"y":2850,"w":236,"h":38},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":313,"y":2922,"w":1870,"h":41}]},{"page":3,"width":2450,"height":3168,"lines":[{"text":"Argument in Favor of Measure","x":281,"y":348,"w":596,"h":47},{"text":"YES on 555 Kelly: The fiscally responsible choice","x":281,"y":514,"w":972,"h":48},{"text":"This referendum is not about voters choosing whether or not to build 555 Kelly. This is because","x":282,"y":624,"w":1835,"h":49},{"text":"555 Kelly is an irreplaceable part of Half Moon Bay's legally required Housing Element and the","x":284,"y":680,"w":1836,"h":48},{"text":"State has already sued Half Moon Bay to force compliance with State law, including affordable","x":284,"y":735,"w":1826,"h":49},{"text":"housing projects like 555 Kelly. Your Yes vote will help to ensure that we do not bankrupt the","x":281,"y":790,"w":1809,"h":48},{"text":"City with fines, penalties and legal costs before the project is finished.","x":284,"y":845,"w":1341,"h":49},{"text":"What is 555 Kelly?","x":283,"y":926,"w":368,"h":47},{"text":"555 Kelly provides 40 affordable apartments at no cost to taxpayers for senior farmworkers","x":355,"y":1005,"w":1748,"h":48},{"text":"who have worked in our fields for decades.","x":354,"y":1060,"w":824,"h":38},{"text":"It will include a community center, with a full kitchen, that will be available to the entire","x":353,"y":1139,"w":1699,"h":48},{"text":"community.","x":353,"y":1195,"w":227,"h":47},{"text":"The project has been fully reviewed and approved.","x":353,"y":1275,"w":968,"h":48},{"text":"Why your Yes Vote is critical for Half Moon Bay:","x":283,"y":1354,"w":961,"h":47},{"text":"The financial risks are not hypothetical. The State of California has already sued Half Moon","x":353,"y":1410,"w":1765,"h":50},{"text":"Bay for not meeting our affordable housing requirements.","x":353,"y":1465,"w":1104,"h":48},{"text":"State law bars cities from rejecting housing like this, even by referendum. Courts can force","x":356,"y":1544,"w":1738,"h":49},{"text":"approval anyway, and fine the city up to $10,000 per unit, per month.","x":353,"y":1599,"w":1329,"h":48},{"text":"A No vote could trigger Builders Remedy, which would result in unchecked development","x":353,"y":1679,"w":1720,"h":49},{"text":"being forced on Half Moon Bay, as well as diverting potentially millions in HMB taxpayer","x":352,"y":1734,"w":1742,"h":49},{"text":"money from vital services to pay legal fees, fines and penalties.","x":352,"y":1790,"w":1214,"h":48},{"text":"The bottom line:","x":282,"y":1869,"w":315,"h":37},{"text":"Under California State law the city must build more affordable housing.","x":352,"y":1947,"w":1379,"h":50},{"text":"Half Moon Bay taxpayers will pay nothing to construct, maintain, or manage 555 Kelly.","x":352,"y":2028,"w":1686,"h":50},{"text":"It's a chance to give back to our senior farmworkers while being fiscally responsible.","x":352,"y":2108,"w":1620,"h":48},{"text":"Your Yes vote can prevent a potentially huge financial loss while helping to solve the city's","x":352,"y":2188,"w":1752,"h":49},{"text":"legal issues instead of making them worse.","x":352,"y":2242,"w":819,"h":47},{"text":"Please vote YES on Measure","x":281,"y":2322,"w":554,"h":38},{"text":"VoteYesOn555Ke11y.com","x":281,"y":2402,"w":498,"h":47},{"text":"13","x":2192,"y":737,"w":61,"h":39},{"text":"3","x":2209,"y":923,"w":31,"h":47},{"text":"15","x":2190,"y":1542,"w":66,"h":43},{"text":"13","x":2195,"y":1605,"w":58,"h":47},{"text":"13","x":2192,"y":1674,"w":61,"h":48},{"text":"13","x":2189,"y":1741,"w":66,"h":43},{"text":"3","x":2197,"y":1873,"w":32,"h":45},{"text":"aeq","x":2174,"y":2536,"w":168,"h":71}]}]}
