124,"w":263,"h":31},{"text":"Date:","x":1091,"y":2373,"w":90,"h":31},{"text":"Title:","x":1088,"y":2477,"w":84,"h":30},{"text":"Homeowner","x":1101,"y":2520,"w":214,"h":32},{"text":"Email:","x":1089,"y":2576,"w":106,"h":30},{"text":"Redwood City, CA 94061","x":595,"y":2718,"w":436,"h":41},{"text":"Date:","x":1087,"y":2776,"w":90,"h":31},{"text":"Submit a second form (this side ly for alternate signers attached to this form and the argument.","x":299,"y":2890,"w":1873,"h":50}]},{"page":4,"width":2448,"height":3168,"lines":[{"text":"Argument in favor of Measure","x":889,"y":288,"w":620,"h":41},{"text":"Mom and pop landlords, homeowners, and longtime Redwood City renters all agree: Rent","x":300,"y":402,"w":1737,"h":48},{"text":"control will keep Redwood City affordable and create stability for our community.","x":299,"y":460,"w":1552,"h":48},{"text":"Corporate landlords and real estate trusts have bought up 87% of multifamily housing in","x":298,"y":575,"w":1697,"h":50},{"text":"Redwood City, and rents have skyrocketed. Our children can't find housing here. Our teachers,","x":299,"y":634,"w":1832,"h":49},{"text":"city employees, and essential workers live far away and commute for hours.","x":297,"y":694,"w":1465,"h":45},{"text":"Residents are getting rent hikes of $350 a month, which may be higher once the temporary 10%","x":298,"y":809,"w":1855,"h":50},{"text":"state rent cap expires. Families are forced out by unjust evictions, intimidation, or health","x":296,"y":868,"w":1698,"h":46},{"text":"problems from neglected repairs. Seniors are at risk of homelessness.","x":296,"y":926,"w":1355,"h":44},{"text":"With Measure , Redwood City will join 30+ cities around California that have enacted fair rent","x":294,"y":1043,"w":1848,"h":45},{"text":"control and meaningful renter protections, including Mountain View and East Palo Alto,","x":294,"y":1102,"w":1678,"h":45},{"text":"Measure will:","x":295,"y":1217,"w":311,"h":35},{"text":"Keep costs stable by allowing predictable rent increases of 60% of inflation or 5%,","x":439,"y":1276,"w":1583,"h":46},{"text":"whichever is lower.","x":435,"y":1335,"w":368,"h":35},{"text":"Guarantee landlords a fair return on their investment—if costs increase, a landlord can","x":437,"y":1392,"w":1671,"h":45},{"text":"petition the city for a larger rent increase.","x":437,"y":1451,"w":790,"h":44},{"text":"Only allow evictions if there is a \"just cause\" (e.g. failure to pay rent, breach of lease,","x":436,"y":1510,"w":1634,"h":48},{"text":"owner moving into the unit).","x":435,"y":1569,"w":536,"h":43},{"text":"Protect against landlord use of intimidation and lack of repairs to push people out of their","x":437,"y":1625,"w":1715,"h":48},{"text":"homes.","x":436,"y":1684,"w":139,"h":34},{"text":"Prevent homelessness through higher relocation assistance for no-fault evictions.","x":436,"y":1742,"w":1572,"h":46},{"text":"Measure _ will be funded by a small fee on landlords—not paid for by homeowners, renters,","x":291,"y":1858,"w":1800,"h":48},{"text":"nor the city's general fund.","x":290,"y":1917,"w":510,"h":43},{"text":"Measure was drafted by a diverse group of Redwood City residents who've been working for","x":289,"y":2033,"w":1855,"h":49},{"text":"a decade to keep families and seniors in their homes, so our community can be safe and strong.","x":288,"y":2091,"w":1863,"h":50},{"text":"Over 7,000 Redwood City voters signed petitions to get Measure on the ballot.","x":289,"y":2149,"w":1578,"h":48},{"text":"Join all of us, your neighbors, and vote YES on Measure to keep Redwood City affordable!","x":287,"y":2266,"w":1815,"h":49},{"text":"AUG 1 1 2026","x":455,"y":2654,"w":261,"h":48},{"text":"CITY OF REDWOOD CITY","x":304,"y":2761,"w":564,"h":46},{"text":"CITY CLERK'S OFFICE","x":334,"y":2819,"w":500,"h":45},{"text":"14","x":2286,"y":574,"w":50,"h":47},{"text":"(7","x":2285,"y":801,"w":54,"h":56},{"text":"14","x":2287,"y":867,"w":57,"h":57},{"text":"IO","x":2285,"y":935,"w":60,"h":44},{"text":"14","x":2277,"y":1026,"w":61,"h":52},{"text":"5","x":2279,"y":1102,"w":50,"h":51},{"text":"2-","x":2282,"y":1213,"w":44,"h":33},{"text":"17","x":2258,"y":1276,"w":68,"h":58},{"text":"17","x":2264,"y":1634,"w":68,"h":47},{"text":"Is","x":2264,"y":2264,"w":61,"h":51}]}]}
