ure:","x":217,"y":2392,"w":179,"h":39},{"text":"5. Name:","x":221,"y":2496,"w":196,"h":42},{"text":"Phone:","x":217,"y":2596,"w":123,"h":30},{"text":"Address:","x":215,"y":2696,"w":156,"h":31},{"text":"Signature:","x":217,"y":2797,"w":178,"h":38},{"text":"Title:","x":1087,"y":879,"w":85,"h":31},{"text":"Date:","x":1088,"y":1179,"w":91,"h":31},{"text":"Title:","x":1085,"y":1284,"w":85,"h":31},{"text":"Email:","x":1088,"y":1384,"w":105,"h":31},{"text":"Date:","x":1086,"y":1584,"w":92,"h":31},{"text":"Title:","x":1084,"y":1689,"w":85,"h":31},{"text":"Email:","x":1086,"y":1790,"w":107,"h":30},{"text":"Date:","x":1084,"y":1989,"w":92,"h":31},{"text":"Title:","x":1082,"y":2093,"w":85,"h":31},{"text":"Email:","x":1084,"y":2194,"w":107,"h":31},{"text":"Date:","x":1083,"y":2394,"w":92,"h":31},{"text":"Title:","x":1082,"y":2498,"w":84,"h":31},{"text":"Email:","x":1082,"y":2598,"w":108,"h":31},{"text":"Date:","x":1082,"y":2799,"w":92,"h":30},{"text":"Submit a second form (this side only) for alternate signers attached to this form and the argument.","x":300,"y":2916,"w":1865,"h":45}]},{"page":7,"width":2448,"height":3168,"lines":[{"text":"FINAL SUBMIT IIAUG2026","x":235,"y":167,"w":707,"h":42},{"text":"PRIMARY Argument Against the San Mateo City Sales Tax Hike (300-Word)","x":234,"y":253,"w":1678,"h":49},{"text":"NOT A PENNY MORE! Vote NO on Measure \"","x":234,"y":410,"w":929,"h":36},{"text":"15","x":2210,"y":489,"w":50,"h":55},{"text":"We all value public safety, well-maintaine@streets, parks, libraries, and the services that makeSpn","x":230,"y":501,"w":1896,"h":49},{"text":"a great place to live. Those services matter. But another sales tax is NOT the solution.","x":365,"y":560,"w":1743,"h":42},{"text":"COST OF LIVING IS TOO HIGH. Families, seniors, and working residents already face rising costs for","x":231,"y":651,"w":1973,"h":45},{"text":"housing, groceries, utilities, insurance, and everyday necessities. Now City Hall wants taxpayers to pay","x":232,"y":709,"w":1980,"h":46},{"text":"even more?","x":230,"y":768,"w":230,"h":34},{"text":"WE ALREADY PAY HIGH TAXES. San Mateo's combined sales tax rate is already 9.625%. This","x":229,"y":859,"w":1860,"h":45},{"text":"measure would add another 0.25%.","x":230,"y":918,"w":686,"h":36},{"text":"THIS ISA ENERAL-PURPOS TAX. The City's ballot specifically mentions streets, parks, potholes,","x":229,"y":1008,"w":1956,"h":45},{"text":"fire protection, paramedics—9-å-1, and traffic safety. But the ballot measure states the approximately $7","x":228,"y":1063,"w":1982,"h":49},{"text":"million in annual revenue is for \"general government use.\" The truth is the money is not restricted","x":230,"y":1125,"w":1907,"h":45},{"text":"exclusively to the services highlighted in the ballot.","x":229,"y":1184,"w":972,"h":43},{"text":"THERE IS NO FIXED SUNSET DATE. Unlike a temporary tax with a defined expiration date, this tax","x":228,"y":1275,"w":1936,"h":44},{"text":"continues \"until ended by voters.\" This means voters may have to get enough petition signatures to","x":229,"y":1333,"w":1964,"h":45},{"text":"seek a separate ballot measure to actually end the tax. Unacceptable.","x":229,"y":1392,"w":1358,"h":44},{"text":"THIS TAX DOESN'T SOLVE THE UNDERLYING PROBLEM. The City's FY 2026-27 budget projects a","x":228,"y":1482,"w":1991,"h":45},{"text":"$16.8 million deficit. This new tax revenue of approximately $7 million would still leave roughly $9.8","x":228,"y":1540,"w":1902,"h":46},{"text":"million unresolved.","x":229,"y":1600,"w":356,"h":33},{"text":"City Hall needs to do better with the tax dollars we already provide. Voters deserve answers.","x":228,"y":1690,"w":1771,"h":44},{"text":"Before asking taxpayers for more, City Hall should demonstrate how it will control spending, improve","x":229,"y":1780,"w":1929,"h":45},{"text":"efficiency, measure performance, prioritize essential services, and address continuing deficits.","x":227,"y":1839,"w":1801,"h":45},{"text":"San Mateo also needs a serious economic strategy that grows revenues through businesses,","x":226,"y":1927,"w":1789,"h":47},{"text":"investment, jobs, and economic activity. Higher taxes should not be the first answer.","x":228,"y":1988,"w":1609,"h":44},{"text":"NOT A PENNY MORE. DO BETTER WITH WHAT WE'VE ALREADY GIVEN YOU.","x":228,"y":2078,"w":1600,"h":36},{"text":"VOTE NO.","x":225,"y":2195,"w":206,"h":34},{"text":"tasozografos@gmail.com;","x":1279,"y":3000,"w":454,"h":38},{"text":"FINAL 8/11/2026 12:50 PM","x":1749,"y":3000,"w":469,"h":31},{"text":"2","x":2240,"y":1603,"w":43,"h":49},{"text":"2","x":2250,"y":2172,"w":56,"h":61}]}]}
