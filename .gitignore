# OpenSlate clone fetched on demand by scripts/workflows
.openslate/

# Build output
dist/

# Node / Bun
node_modules/
bun.lockb

# Keys and identities: the signing key only lives in CI secrets
*.key
*.identity.json
*signing*.json

# The signed manifest is a CI build artifact, not committed source
guide/guide.jws
county/*/guide.jws

# Large originals (county pamphlet PDFs): only their URL and SHA-256 are committed
.cache/
